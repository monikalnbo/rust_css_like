// ==============================================================================
// 示例 3：组件化封装与主题定制 (examples/components_demo.ui)
// 语法特色：自定义 component 定义、多实例复用、主题样式
// ==============================================================================

// 1. 定义可复用卡片组件
component StatCard(title, value, badge_color) {
    col pad=16 bg=#1e293b rad=10 gap=8 flex=1 {
        row justify=between align=center {
            txt title #94a3b8 12px bold
            box w=8 h=8 rad=4 bg=badge_color
        }
        txt value #f8fafc 24px bold
    }
}

// 2. 主页面装配
win "商业仪表盘" (720, 480) bg=#0f172a {
    col pad=24 gap=20 flex=1 {
        txt "平台运行统计" #f8fafc 20px bold

        // 横向卡片栅格
        row gap=12 {
            StatCard(title="日活跃用户", value="12,480", badge_color=#22c55e)
            StatCard(title="实时 QPS", value="3,820", badge_color=#3b82f6)
            StatCard(title="系统负载", value="18.2%", badge_color=#eab308)
        }

        // 底层特效挂载卡片
        card pad=20 bg=#1e293b rad=12 effect="InteractiveRipple" {
            txt "点击下方卡片，查看底层物理水波光晕扩散" #94a3b8 14px
        }
    }
}
