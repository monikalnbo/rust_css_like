// ==============================================================================
// 示例 1：极简响应式计数器 (examples/counter.ui)
// 语法特色：零样板代码、响应式状态与动作流直连
// ==============================================================================

let count = 0

win "极简计数器应用" (400, 300) bg=#0f172a {
    col pad=32 gap=20 align=center justify=center flex=1 {
        txt "极简前端语言演示" #94a3b8 14px
        txt "当前计数: $count" #f8fafc 28px bold

        row gap=12 {
            btn "减少 (-1)" pad=(8, 16) bg=#334155 rad=6 -> count -= 1
            btn "重置 (0)" pad=(8, 16) bg=#64748b rad=6 -> count = 0
            btn "增加 (+1)" pad=(8, 16) bg=#4f46e5 rad=6 -> count += 1
        }
    }
}
